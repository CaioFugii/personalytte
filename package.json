{
  "name": "personalytte",
  "private": true,
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "pnpm --dir backend build && if [ -f frontend/package.json ]; then pnpm --dir frontend build; fi",
    "start": "node backend/dist/main.js",
    "horizonte": "node backend/dist/horizonte.js",
    "test": "pnpm --dir backend test"
  }
}
